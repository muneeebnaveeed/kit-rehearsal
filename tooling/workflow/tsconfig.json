{
  // Typechecks every TypeScript file in the workflow tooling. The .mjs scripts are typed through allowJs inference.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts", "lib/*.ts"]
}
